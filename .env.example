# Copy to .env and adjust before running `docker compose up -d`.

# Host port the helpdesk is published on (container always listens on 8080).
HTTP_HOST_PORT=8080

# Redis password (shared by the redis service and the app).
REDIS_PASSWORD=change-me-redis-password

# HMAC signing key for issued JWTs. Change this in any non-throwaway deployment.
JWT_SECRET=change-me-to-a-long-random-32char-min-secret

# API key required on the partner-integration endpoints (X-Api-Key header).
HELPDESK_API_KEY=hd_live_change_me
